<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ShaPrint.UI.ViewModels.Pages"
             xmlns:network="using:ShaPrint.Core.Network"
             x:Class="ShaPrint.UI.Views.Pages.ServerPage"
             x:DataType="vm:ServerViewModel">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,*" Margin="20,16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="Server Dashboard" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Select printers and scanners to expose to the network:" Foreground="Gray" />
        </StackPanel>

        <!-- Exposed devices: selection lives in the VM's IList SelectedPrinters/SelectedScanners
             (ListBox.SelectedItems, SelectionMode="Multiple,Toggle") — NO IsSelected on the item
             models (plan Task 5/6 rule). Disabled while the server is running (same as WPF). -->
        <Grid Grid.Row="1" ColumnDefinitions="*,16,*">
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Exposed Printers" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Printers}"
                         SelectionMode="Multiple,Toggle"
                         SelectedItems="{Binding SelectedPrinters}"
                         IsEnabled="{Binding IsNotRunning}"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrinterItem">
                            <TextBlock Text="{Binding Name}" Padding="2,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Exposed Scanners" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,0,0,4" />
                <ListBox ItemsSource="{Binding Scanners}"
                         SelectionMode="Multiple,Toggle"
                         SelectedItems="{Binding SelectedScanners}"
                         IsEnabled="{Binding IsNotRunning}"
                         BorderBrush="#D1D5DB"
                         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScannerItem">
                            <TextBlock Text="{Binding Name}" Padding="2,1" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Controls bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="{Binding ToggleButtonText}" Command="{Binding ToggleServerCommand}" MinWidth="120" />
        </Grid>

        <!-- Recent jobs (ServerStatusPayload-shaped history; ConcurrentQueue, read-only) -->
        <TextBlock Grid.Row="3" Text="Recent Jobs" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,14,0,4" />
        <Border Grid.Row="4" BorderBrush="#D1D5DB" BorderThickness="1" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding RecentJobs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="network:JobHistoryEntry">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,3">
                                <TextBlock Text="{Binding Timestamp}" Foreground="Gray" />
                                <TextBlock Text="{Binding Document}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PrinterName}" Foreground="Gray" />
                                <TextBlock Text="{Binding ClientIp}" Foreground="Gray" />
                                <TextBlock Text="{Binding Status}" Foreground="Gray" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Activity log (live; same panel as WPF) -->
        <TextBlock Grid.Row="5" Text="Activity Log" FontSize="12" FontWeight="SemiBold" Foreground="Gray" Margin="0,14,0,4" />
        <TextBox Grid.Row="6"
                 Text="{Binding LogsText, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas, Courier New"
                 FontSize="11"
                 BorderBrush="#D1D5DB"
                 BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Grid>
</UserControl>
