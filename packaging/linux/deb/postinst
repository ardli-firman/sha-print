#!/bin/sh
set -e

# Set up FHS directories with least-privilege modes
mkdir -p /etc/shaprint /etc/shaprint-credentials /var/lib/shaprint /run/shaprint
chown root:shaprint /etc/shaprint /etc/shaprint-credentials
chmod 0750 /etc/shaprint /etc/shaprint-credentials

for grp in sys lp lpadmin; do
    if getent group "$grp" >/dev/null 2>&1; then
        usermod -a -G "$grp" shaprint 2>/dev/null || adduser shaprint "$grp" >/dev/null 2>&1 || true
    fi
done

chown shaprint:shaprint /var/lib/shaprint /run/shaprint
chmod 0700 /var/lib/shaprint
chmod 0755 /run/shaprint

if [ -f /etc/shaprint/config.json ]; then
    chown root:shaprint /etc/shaprint/config.json
    chmod 0640 /etc/shaprint/config.json
fi

# Create runtime directory if systemd-tmpfiles is available
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/shaprint.conf >/dev/null 2>&1 || true
fi

# Reload systemd and enable/start service
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "$1" = "configure" ]; then
        systemctl enable shaprintd.service >/dev/null 2>&1 || true
        if [ -d /run/systemd/system ]; then
            systemctl restart shaprintd.service >/dev/null 2>&1 || true
        fi
    fi
fi

# Update desktop menu database and icon cache if desktop environment tools exist
if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database -q /usr/share/applications || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
fi

exit 0
